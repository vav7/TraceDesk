# ── Frontend environment (all optional) ─────────────────────────────────
# Local dev needs NO .env at all: the frontend calls same-origin /api and
# Vite proxies it to http://localhost:3001 (see vite.config.ts).
#
# Only set VITE_API_URL for SPLIT deployments, where the frontend is hosted
# separately from the API (e.g. Vercel frontend + Render backend):
# VITE_API_URL=https://your-backend.onrender.com/api
