# ── Backend environment (everything optional for local dev) ─────────────
# No DATABASE_URL? TraceDesk runs on a zero-config in-memory PostgreSQL
# (pg-mem): schema auto-migrated and demo data auto-seeded at startup.
# Data resets on restart — perfect for demos, tests, and local development.

PORT=3001
NODE_ENV=development

# Persistent PostgreSQL (Supabase, Neon, RDS, local…). When set, the server
# verifies connectivity, auto-applies migrations (if missing) and seeds demo
# data (if the database is empty).
# DATABASE_URL=postgresql://postgres:password@localhost:5432/tracedesk

# DB_MODE=memory      # force in-memory even when DATABASE_URL is set
# DB_STRICT=true      # fail at startup if PostgreSQL is unreachable (no fallback)
# AUTO_MIGRATE=true   # apply schema migrations at startup when missing (default: true)
# AUTO_SEED=true      # seed demo data into empty databases (default: true)

# CORS — comma-separated list of allowed frontend origins.
# Same-origin requests are always allowed (single-service deployments).
# FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app

# Static frontend serving — auto-enabled when <repo>/dist/index.html exists.
# SERVE_STATIC=true            # set to "false" to disable
# STATIC_DIR=/path/to/dist     # override the frontend build location

# ── Optional AI-assisted runbooks (zero budget) ─────────────────────────
# Any OpenAI-compatible free tier works: Groq, Google Gemini's
# OpenAI-compatible endpoint, OpenRouter free models, or local Ollama.
# Without AI_API_KEY the app runs fully on the deterministic engine.
# AI_API_KEY=gsk_your_free_groq_key
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.1-8b-instant

# ── Webhooks & rate limits (all optional) ───────────────────────────────
# Require callers to send X-Webhook-Secret (or Authorization: Bearer) on
# POST /api/webhooks/:slug. Unset = open demo listener.
# WEBHOOK_SECRET=change-me
# WEBHOOK_RATE_LIMIT=120      # deliveries per minute per IP
# SIMULATE_RATE_LIMIT=60      # lab simulations per minute per IP
# GROUP_WINDOW_MINUTES=10     # repeated identical failures group into one incident within this window

# ── Custom Endpoint (BYO API) connector ─────────────────────────────────
# Private/loopback targets (localhost, 127.x, 192.168.x, *.local) are blocked
# by default to harden against SSRF; cloud-metadata hosts are ALWAYS blocked.
# ALLOW_PRIVATE_TARGETS=true   # local development only
