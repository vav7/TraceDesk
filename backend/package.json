{
  "name": "tracedesk-backend",
  "version": "2.0.0",
  "description": "TraceDesk backend API",
  "main": "dist/app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "ts-node src/migrate.ts",
    "seed": "ts-node src/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.0.0",
    "pg": "^8.11.3",
    "pg-mem": "^2.8.0",
    "uuid": "^9.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.18",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.10.2",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.8"
  }
}
